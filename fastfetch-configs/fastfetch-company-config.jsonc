{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "C:/Users/teixvibr/.config/fastfetch/bbraun-ascii-art.txt",
    "color": 
    { 
    "1": "#00B382",
    "2": "#00B382", 
    "3": "#00B382",
    "4": "#00B382"
    },

    "padding": 
    {
	  "top": 0,
      "left": 0,
      "right": 0
    }
  },
  "display": {
	"color": {
		"keys": "#00B382",
		"title": "#00B382"
    }
  },
  "modules": [
    //{
    //  "type": "custom",
    //  "format": ""
    //},
    //"title",
    { "type": "title", "format": "\u001b[38;2;0;179;130m  {user-name}@{host-name}\u001b[0m" },
    {
      "type": "custom",
      "format": " \u001b[38;2;114;29;133m╭────────────────────────────────────────────────────────────╮\u001b[0m"
    },
    "break",
    { "type": "os", "key": "  os" },
    { "type": "host", "key": "  host" },
    { "type": "kernel", "key": "  kernel" },
    { "type": "uptime", "key": "  uptime" },
    //{ "type": "packages", "key": "  packages" },
    { "type": "shell", "key": "  shell" },
    { "type": "terminal", "key": "  terminal" },
    { "type": "display", "key": "  display" },
    { "type": "de", "key": "  de" },
    { "type": "cpu", "key": "  cpu" },
    { "type": "gpu", "key": "  gpu" },
    { "type": "memory", "key": "  memory" },
    { "type": "disk", "key": "  disk" },
    { "type": "battery", "key": "  battery" },
    { "type": "poweradapter", "key": "  poweradapter" },
    { "type": "localip", "key": "  localip" },
    "break",
    {
      "type": "custom",
      "format": " \u001b[38;2;114;29;133m╰────────────────────────────────────────────────────────────╯\u001b[0m"
    }
  ]
}
